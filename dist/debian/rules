#!/usr/bin/make -f
RIVALCFG_VERSION := 4.17.0
RIVALCFG_URL := https://github.com/flozz/rivalcfg/releases/download/v$(RIVALCFG_VERSION)/rivalcfg-cli_v$(RIVALCFG_VERSION)_linux_x86_64.tar.gz
RIVALCFG_TAR := rivalcfg-cli_v$(RIVALCFG_VERSION)_linux_x86_64.tar.gz
RIVALCFG_SHA256 := d8881925f60a00b3ca41a9cd92e73d2ddcb67be15e836ee468740d1f8bbca394

PKGDIR     := debian/rivalcfg-gui
# Where the app lands inside the built tree, and where it lands once installed.
APP_PREFIX := /usr/share/rivalcfg-gui
APPDIR     := $(PKGDIR)$(APP_PREFIX)

# The generated files below are written with printf rather than a heredoc.
# make runs every recipe line in its own shell, so a heredoc body would never
# reach `cat`: the file came out empty and the body lines were executed as
# commands instead.  `$$` is a literal `$` for the shell; a single `$(...)`
# would be expanded by make.

%:
	dh $@

override_dh_auto_build:
	wget -q -O $(RIVALCFG_TAR) $(RIVALCFG_URL)
	echo "$(RIVALCFG_SHA256)  $(RIVALCFG_TAR)" | sha256sum -c -
	tar xzf $(RIVALCFG_TAR)

override_dh_auto_install:
	install -d $(APPDIR)

	# The whole application is one package directory now, with assets/ and
	# locales/ inside it.  Copying it wholesale is what keeps this package from
	# drifting out of sync with the app: the previous hand-written module list
	# was missing lighting_fx.py and aerox5_mesh.py, both of which the app
	# imports, so the installed GUI could not start.
	#
	# This rule stages the package directory directly, so there is deliberately
	# no debian/install file.  dh_install resolves the source side of its entries
	# against the source tree root (falling back to debian/tmp), so an entry
	# pointing at usr/share/rivalcfg-gui/* could never match here and would fail
	# the build rather than copy anything.
	cp -r rivalcfg_gui $(APPDIR)/rivalcfg_gui
	find $(PKGDIR) -name '__pycache__' -type d -prune -exec rm -rf {} +
	find $(PKGDIR) -name '*.pyc' -delete

	# _find_rivalcfg() prefers a rivalcfg binary sitting beside the modules, so
	# the bundled standalone binary goes inside the package directory.
	install -Dm755 rivalcfg-cli_v$(RIVALCFG_VERSION)_linux_x86_64/rivalcfg \
		$(APPDIR)/rivalcfg_gui/rivalcfg

	# The modules use package-relative imports, so rivalcfg_gui.py can no longer
	# be executed as a bare script path.  Launch through -m with the package's
	# parent directory on the path.
	install -d $(PKGDIR)/usr/bin
	printf '%s\n' \
		'#!/bin/sh' \
		'export PYTHONPATH="$(APP_PREFIX)$${PYTHONPATH:+:$$PYTHONPATH}"' \
		'exec python3 -m rivalcfg_gui "$$@"' \
		> $(PKGDIR)/usr/bin/rivalcfg-gui
	chmod 755 $(PKGDIR)/usr/bin/rivalcfg-gui

	install -d $(PKGDIR)/usr/share/applications
	printf '%s\n' \
		'[Desktop Entry]' \
		'Version=1.0' \
		'Type=Application' \
		'Name=RivalCFG GUI' \
		'Comment=SteelSeries mouse configuration tool' \
		'Exec=/usr/bin/rivalcfg-gui' \
		'Icon=$(APP_PREFIX)/rivalcfg_gui/assets/logo.png' \
		'Terminal=false' \
		'Categories=Utility;Settings;' \
		'StartupWMClass=rivalcfg-gui' \
		> $(PKGDIR)/usr/share/applications/rivalcfg-gui.desktop

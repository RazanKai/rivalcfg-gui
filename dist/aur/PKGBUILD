# Maintainer: MrGodzilla38 <oyunustasigodzilla@gmail.com>
pkgname=rivalcfg-gui
pkgver=1.6.0
pkgrel=1
pkgdesc="GTK3 GUI configuration tool for SteelSeries mice (via rivalcfg)"
arch=('any')
url="https://github.com/MrGodzilla38/rivalcfg-gui"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'python-cairo' 'rivalcfg')
install=rivalcfg-gui.install
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/MrGodzilla38/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # Install application files (ALL project files including locale, images, Python files, etc.)
    install -d "${pkgdir}/usr/share/${pkgname}"

    # Copy project files, excluding build/CI directories
    find . -mindepth 1 -maxdepth 1 \
      ! -name 'dist' ! -name '.git' ! -name '.github' ! -name '__pycache__' \
      -exec cp -r {} "${pkgdir}/usr/share/${pkgname}/" \;
    find "${pkgdir}/usr/share/${pkgname}" -name '__pycache__' -type d -prune -exec rm -rf {} +
    find "${pkgdir}/usr/share/${pkgname}" -name '*.pyc' -delete

    # Launch through the package: the modules use package-relative imports now,
    # so rivalcfg_gui.py can no longer be executed as a bare script path.
    install -d "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/${pkgname}" <<EOF
#!/bin/sh
export PYTHONPATH="/usr/share/${pkgname}\${PYTHONPATH:+:\$PYTHONPATH}"
exec python3 -m rivalcfg_gui "\$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/${pkgname}"

    # Create desktop entry
    install -d "${pkgdir}/usr/share/applications"
    cat > "${pkgdir}/usr/share/applications/${pkgname}.desktop" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=RivalCFG GUI
Comment=SteelSeries mouse configuration tool
Exec=${pkgname}
Icon=/usr/share/${pkgname}/rivalcfg_gui/assets/logo.png
Terminal=false
Categories=Utility;Settings;
StartupWMClass=rivalcfg-gui
EOF
}
